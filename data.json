// ==========================================
// GITHUB AUTO-COMMIT INTEGRATION (FIXED)
// ==========================================

// កំណត់ Default Owner និង Repo ដើម្បីឱ្យ Device ទាំងអស់អាចទាញទិន្នន័យបាន
function getGitHubConfig() {
    return {
        owner: localStorage.getItem('GH_OWNER') || 'Research-Foundation', // ឈ្មោះ Owner ដើម
        repo: localStorage.getItem('GH_REPO') || 'research-foundation',     // ឈ្មោះ Repo ដើម
        branch: localStorage.getItem('GH_BRANCH') || 'main',
        token: localStorage.getItem('GH_TOKEN') || '',                     // Token ទុកតែលើម៉ាស៊ីន Admin
        path: 'data.json'
    };
}

// 1. Fetch data.json from GitHub on page load (ដំណើរការគ្រប់ Device ទាំងអស់)
async function loadDataFromGitHub() {
    const config = getGitHubConfig();
    let loadedSuccessfully = false;

    try {
        // បន្ថែម timestamp (?t=...) ដើម្បីការពារកុំឱ្យ Browser ចងចាំ Cache ចាស់
        const url = `https://raw.githubusercontent.com/${config.owner}/${config.repo}/${config.branch}/${config.path}?t=${Date.now()}`;
        const response = await fetch(url);
        
        if (response.ok) {
            const remoteData = await response.json();
            // ពិនិត្យមើលថាតើទិន្នន័យពី GitHub ត្រឹមត្រូវ និងមានទិន្នន័យសៀវភៅដែរឬទេ
            if (remoteData && remoteData.books && remoteData.books.length > 0) {
                appData = remoteData;
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
                loadedSuccessfully = true;
            }
        }
    } catch (err) {
        console.warn('មិនអាចទាញយក data.json ពី GitHub បានទេ កំពុងប្រើប្រាស់ Local Cache:', err);
    }

    // ប្រសិនបើតេស្តទាញយកពី GitHub មិនបាន ទើបឱ្យវាធ្លាក់មកប្រើ Local Cache
    if (!loadedSuccessfully) {
        loadAppState();
    }

    renderAllSections();
}

// 2. Commit updated data.json to GitHub using GitHub REST API
async function commitDataToGitHub() {
    const config = getGitHubConfig();
    
    // បើគ្មាន Token ទេ គ្រាន់តែ Save ក្នុងម៉ាស៊ីន Admin
    if (!config.token) {
        saveAppState();
        showToast('បានរក្សាទុកក្នុងម៉ាស៊ីន (សូមកំណត់ GitHub Token ដើម្បី Sync ទៅ Online)');
        return;
    }

    showToast('កំពុង Commit ទៅកាន់ GitHub...');

    try {
        const apiUrl = `https://api.github.com/repos/${config.owner}/${config.repo}/contents/${config.path}`;
        
        // Step A: Get current file SHA
        let fileSha = null;
        const getFile = await fetch(apiUrl, {
            headers: {
                'Authorization': `Bearer ${config.token}`,
                'Accept': 'application/vnd.github.v3+json'
            }
        });

        if (getFile.ok) {
            const fileInfo = await getFile.json();
            fileSha = fileInfo.sha;
        }

        // Step B: Encode data to Base64 (Unicode safe សម្រាប់ភាសាខ្មែរ)
        const jsonString = JSON.stringify(appData, null, 2);
        const encodedContent = btoa(unescape(encodeURIComponent(jsonString)));

        // Step C: PUT request to commit changes
        const commitResponse = await fetch(apiUrl, {
            method: 'PUT',
            headers: {
                'Authorization': `Bearer ${config.token}`,
                'Accept': 'application/vnd.github.v3+json',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                message: `Auto-update site data [${new Date().toLocaleString()}]`,
                content: encodedContent,
                sha: fileSha,
                branch: config.branch
            })
        });

        if (commitResponse.ok) {
            saveAppState();
            showToast('✓ បាន Sync ទៅ GitHub រួចរាល់! គ្រប់ Device ទាំងអស់នឹងឃើញរូបភាព');
        } else {
            const errData = await commitResponse.json();
            throw new Error(errData.message || 'Commit failed');
        }
    } catch (err) {
        console.error('GitHub Sync Error:', err);
        showToast('បរាជ័យក្នុងការ Commit ទៅ GitHub: ' + err.message);
        saveAppState();
    }
}
